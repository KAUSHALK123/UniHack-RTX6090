# ==============================================================================
# AI-Powered Product Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit .env or sensitive secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
LOG_LEVEL=info

# API Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Web Frontend Configuration
VITE_API_URL=http://localhost:8000
PORT=5173

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL=sqlite:///./data/product_intelligence.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_intelligence

# Redis / Cache Configuration (Optional / Future pipeline queue)
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration (Placeholders — DO NOT put real keys in .env.example)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Reference Data & Datasets
UNILOG_DATA_DIR=./data/reference
REFERENCE_DATASETS_PATH=./data

# Vector Database / Embeddings (Optional)
CHROMA_PERSIST_DIR=./data/chroma
